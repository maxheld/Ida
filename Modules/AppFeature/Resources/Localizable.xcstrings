    "about.privacy.data.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ida speichert Kindernamen, Einträge und Erinnerungen, damit Verlauf und Benachrichtigungen funktionieren. Die Daten bleiben auf deinem Gerät und werden bei aktiviertem iCloud-Sync über deine private iCloud-Datenbank sowie mit Personen synchronisiert, mit denen du ausdrücklich teilst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ida stores child names, entries, and reminders so timeline history and notifications work. Data stays on your device and, when iCloud sync is enabled, is synced via your private iCloud database and with people you explicitly share with."
          }
        }
      }
    },
